FROM python:3.11-slim

WORKDIR /EROS4NRG
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/EROS4NRG

COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir -r requirements.txt

COPY config ./config
COPY clients ./clients
COPY dataset.py facebook_prophet.py regressors.py train_MLP.py utils.py start_training.sh ./

RUN chmod +x /EROS4NRG/start_training.sh

CMD ["bash", "start_training.sh"]
